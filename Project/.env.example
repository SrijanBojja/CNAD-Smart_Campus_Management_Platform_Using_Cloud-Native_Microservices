# ============================================================
# Smart Campus Management Platform — Environment Configuration
# Copy this file to .env and adjust variables as required.
# ============================================================

# Database Configuration (Containerized MySQL)
# MySQL inside Docker network uses port 3306.
# Host port mapping is set to 3307 by default to avoid conflict with local MySQL.
DB_HOST=mysql
DB_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=smart_campus_auth
MYSQL_USER=smartcampus_user
MYSQL_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_secure_root_password

# JWT Security Configuration
# Must be at least 256 bits (32 bytes) hex/base64 encoded string
JWT_SECRET=your_256_bit_jwt_secret_key_here_must_be_sufficiently_long
JWT_EXPIRATION_MS=86400000

# Initial Admin Account Seeding
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_secure_admin_password
INITIAL_ADMIN_EMAIL=admin@smartcampus.com

# Inter-Service Communication (Docker Network URLs)
AUTH_SERVICE_URL=http://auth-service:8081
STUDENT_SERVICE_URL=http://student-service:8082
ACADEMIC_SERVICE_URL=http://academic-service:8083
ATTENDANCE_SERVICE_URL=http://attendance-service:8084
EVENT_SERVICE_URL=http://event-service:8085
FACILITY_SERVICE_URL=http://facility-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8087

# Ports Exposed on Host
API_GATEWAY_PORT=8080
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

